# ═══════════════════════════════════════════════════════════════════════════════
# Template para instancias numeradas (parking-1, parking-2, etc.)
# Uso: make new-instance INSTANCE=1
#      (copia este archivo a .env.parking-1 y guía la configuración)
#
# O manual:
#   cp .env.parking-N.example .env.parking-1
#   <editar los valores marcados como [REQUERIDO]>
#   make setup INSTANCE=1
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Puerto de la instancia ───────────────────────────────────────────────────
# Único por instancia: 8080 para la 1, 8081 para la 2, 8082 para la 3, etc.
APP_PORT=8080

# ─── Base de datos (Postgres) ─────────────────────────────────────────────────
# Credenciales únicas por instancia para aislar los datos completamente.
DB_NAME=parking_b1
DB_USER=parking_b1_user
DB_PASSWORD=parking_b1_pass

# ─── Django core ──────────────────────────────────────────────────────────────
# [REQUERIDO] Generar con:
#   python -c "import secrets; print(secrets.token_hex(64))"
DJANGO_SECRET_KEY=

# Modo producción (dejar en 0)
DJANGO_DEBUG=0

# Dominio o IP del servidor donde corre esta instancia (coma-separado)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes de confianza para CSRF — incluir el dominio real en prod
# Ej: https://cochera-central.com,http://localhost:8080
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# ─── Superadmin inicial ────────────────────────────────────────────────────────
# Se crea automáticamente en el primer arranque si no existe.
DJANGO_SUPERUSER_EMAIL=admin@parking.com
DJANGO_SUPERUSER_USERNAME=admin
# [REQUERIDO] Contraseña fuerte (mínimo 12 caracteres)
DJANGO_SUPERUSER_PASSWORD=

# ─── Identidad del negocio ────────────────────────────────────────────────────
BUSINESS_NAME=Cochera Central
BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires

# ─── Performance ──────────────────────────────────────────────────────────────
# Workers de gunicorn = (2 * CPUs) + 1 como regla general
GUNICORN_WORKERS=2
