# ═══════════════════════════════════════════════════════════════════════════════
# Template de configuración — Forin Cars / Gestor de Cocheras
# Uso: cp .env.example .env.parking-1
#      Editar los valores marcados como [REQUERIDO]
#      Luego: make setup INSTANCE=1
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Puertos ──────────────────────────────────────────────────────────────────
# APP_PORT debe ser único por instancia: 8080 para instancia 1, 8081 para la 2, etc.
APP_PORT=8080

# ─── Django core ─────────────────────────────────────────────────────────────
# [REQUERIDO] Generar con: python -c "import secrets; print(secrets.token_hex(64))"
DJANGO_SECRET_KEY=

# 1 = modo desarrollo (hot-reload, sin HTTPS forzado); 0 = producción
DJANGO_DEBUG=0

# Hosts que Django acepta (coma-separado). En prod: dominio real o IP del servidor.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes permitidos para CSRF (necesario cuando el frontend está en otro origen)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# ─── Base de datos ────────────────────────────────────────────────────────────
# Postgres por instancia — credenciales únicas para aislar los datos.
# Formato: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# [REQUERIDO] Para desarrollo local con SQLite usar: sqlite:///db.sqlite3
DATABASE_URL=postgres://parking_b1_user:parking_b1_pass@db:5432/parking_b1

# ─── Superadmin inicial ────────────────────────────────────────────────────────
# Se crea en el primer arranque si no existe.
DJANGO_SUPERUSER_EMAIL=admin@parking.com
DJANGO_SUPERUSER_USERNAME=admin
# [REQUERIDO] Contraseña segura (mínimo 12 caracteres)
DJANGO_SUPERUSER_PASSWORD=

# ─── Identidad del negocio ───────────────────────────────────────────────────
# Nombre del negocio — aparece en el navbar y en los tickets PDF
BUSINESS_NAME=Forin Cars

# ─── Zona horaria ─────────────────────────────────────────────────────────────
# Usar zona del negocio: America/Argentina/Buenos_Aires, America/Santiago, etc.
BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires

# ─── Email (opcional) ─────────────────────────────────────────────────────────
# En desarrollo usar Mailhog (puerto 1025, sin credenciales)
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@parking.local

# ─── Observabilidad (opcional) ───────────────────────────────────────────────
SENTRY_DSN=
